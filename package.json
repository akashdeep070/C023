{
  "name": "lex-ai",
  "version": "2.0.0",
  "private": true,
  "description": "LEX AI: a small cloud vault for legal files, with Groq-powered reading",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,black \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "deck": "node scripts/build-deck.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "multer": "2.5.0",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
